<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-License-Identifier: GPL-3.0-or-later
  Entitlements of a Developer ID build (packaging/macos/build.sh with SIGN_IDENTITY), which is
  signed with the hardened runtime: Qt's QML engine compiles JavaScript and bindings to machine
  code in MAP_JIT pages, which the hardened runtime refuses without allow-jit. The ad hoc build
  has no hardened runtime and needs none.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
